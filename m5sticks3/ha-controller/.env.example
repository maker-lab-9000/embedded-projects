# Copy to .env (gitignored) and fill in. Regenerate headers after editing:
#   python3 m5sticks3/ha-controller/tools/gen_config.py
WIFI_SSID=MyNetwork
WIFI_PASSWORD=MyPassword
# Host or IP only (no http:// and no :port here). Use the IP if
# homeassistant.local does not resolve on your network:
HA_HOST=homeassistant.local
HA_PORT=8123
# Home Assistant > Profile > Long-lived access tokens > Create Token
HA_TOKEN=paste-long-lived-token-here
# The single controllable light — a full entity_id from Developer Tools > States:
LIGHT_ENTITY=light.living_room
LIGHT_LABEL=Living Room
# Dashboard (read-only) entities, ';'-separated, each "entity_id|Label|unit"
# (unit may be empty). Example:
DISPLAY_ENTITIES=sensor.living_temperature|Temp|C;sensor.living_humidity|Humidity|%;binary_sensor.front_door|Door|
